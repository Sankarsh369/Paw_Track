@page
@model PawTrack.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <div class="form-card">
        <span class="eyebrow">Welcome back</span>
        <h2 class="mt-8 mb-24">Log in to PawTrack</h2>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-faint"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-faint"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Log in</button>
        </form>

        <p class="text-faint mt-16 text-center">
            New to PawTrack? <a href="/Account/Register">Create an adopter account</a>
        </p>
    </div>
</div>
