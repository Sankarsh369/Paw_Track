@page
@model PawTrack.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Staff Console";
    ViewData["Nav"] = "admin";
    ViewData["AdminNav"] = "overview";
}

<section class="section">
    <div class="container">
        <span class="eyebrow">Staff console</span>
        <h1 class="mt-8 mb-24">Operations overview</h1>

        <partial name="_AdminNav" />

        @if (Model.IsOrgAdmin && Model.OrgDashboard is not null)
        {
            var d = Model.OrgDashboard;
            <div class="stat-cards">
                <div class="stat-card"><span class="num">@d.TotalBranches</span><span class="label">Branches</span></div>
                <div class="stat-card"><span class="num">@d.TotalAnimals</span><span class="label">Total animals</span></div>
                <div class="stat-card"><span class="num">@d.TotalAdoptions</span><span class="label">Adoptions</span></div>
                <div class="stat-card"><span class="num">@d.TotalActiveApplications</span><span class="label">Pending applications</span></div>
                <div class="stat-card"><span class="num">@d.TotalDonations.ToString("C0")</span><span class="label">Donations raised</span></div>
                <div class="stat-card"><span class="num">@d.TotalAdoptionFees.ToString("C0")</span><span class="label">Adoption fees</span></div>
            </div>

            <div class="ledger-panel">
                <div class="panel-head"><h3>By branch</h3></div>
                <table class="ledger">
                    <thead>
                        <tr><th>Branch</th><th>Total</th><th>Available</th><th>Adopted</th><th>Pending apps</th><th>Visits this month</th><th>Donations</th><th>Fees</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in d.ByBranch)
                        {
                            <tr>
                                <td>@b.BranchName</td>
                                <td class="num-cell">@b.TotalAnimals</td>
                                <td class="num-cell">@b.AvailableAnimals</td>
                                <td class="num-cell">@b.AdoptedAnimals</td>
                                <td class="num-cell">@b.PendingApplications</td>
                                <td class="num-cell">@b.VisitsThisMonth</td>
                                <td class="num-cell">@b.DonationTotal.ToString("C0")</td>
                                <td class="num-cell">@b.AdoptionFeeTotal.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>Use the tabs above to manage day-to-day operations</h3>
                <p>Org-wide reporting is visible to Org Admin accounts.</p>
            </div>
        }
    </div>
</section>
