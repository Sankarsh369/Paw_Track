@page "/"
@inject ApiClientService ApiClient
@implements IDisposable

<div class="adopter-portal">
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #6ee7b7; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <span>@feedbackMessage</span>
            <button @onclick="() => feedbackMessage = null" style="background: none; border: none; color: inherit; cursor: pointer;">✕</button>
        </div>
    }

    <!-- Sub Navigation Tabs -->
    <div style="display: flex; gap: 12px; margin-bottom: 20px;">
        <button class="btn @(activeSubTab == "animals" ? "btn-primary" : "btn-secondary")" @onclick='() => activeSubTab = "animals"'>
            ❤️ Browse Rescued Pets
        </button>
        <button class="btn @(activeSubTab == "applications" ? "btn-primary" : "btn-secondary")" @onclick='() => activeSubTab = "applications"'>
            📄 My Applications (@applications.Count)
        </button>
        <button class="btn @(activeSubTab == "visits" ? "btn-primary" : "btn-secondary")" @onclick='() => activeSubTab = "visits"'>
            📅 My Booked Visits (@visits.Count)
        </button>
    </div>

    @if (activeSubTab == "animals")
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
            @foreach (var pet in pets)
            {
                <div class="pet-card" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden;">
                    @if (!string.IsNullOrEmpty(pet.ImageUrl))
                    {
                        <img src="@pet.ImageUrl" alt="@pet.Name" style="width: 100%; height: 180px; object-fit: cover;" />
                    }
                    <div style="padding: 16px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <h3 style="margin: 0; font-size: 1.15rem;">@pet.Name</h3>
                            <span class="status-pill status-@pet.Status" style="padding: 3px 8px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: @(pet.Status == AnimalStatus.Available ? "rgba(16, 185, 129, 0.2)" : "rgba(99, 102, 241, 0.2)"); color: @(pet.Status == AnimalStatus.Available ? "#34d399" : "#818cf8");">
                                @pet.Status
                            </span>
                        </div>
                        <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">
                            @pet.Species • @pet.Breed • @pet.Age yrs • @pet.Gender
                        </div>
                        <div style="font-size: 0.85rem; color: #cbd5e1; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @pet.Description
                        </div>

                        <div style="display: flex; gap: 8px;">
                            <button class="btn btn-secondary" style="flex: 1; padding: 6px 12px; font-size: 0.85rem;" disabled="@(pet.Status != AnimalStatus.Available)" @onclick="() => OpenBookVisitModal(pet)">
                                📅 Book Visit
                            </button>
                            <button class="btn btn-primary" style="flex: 1; padding: 6px 12px; font-size: 0.85rem;" disabled="@(pet.Status != AnimalStatus.Available)" @onclick="() => OpenApplyModal(pet)">
                                ❤️ Apply
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeSubTab == "applications")
    {
        <div style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 20px;">
            <h2 style="margin-top: 0; font-size: 1.25rem;">My Adoption Applications</h2>
            @if (applications.Count == 0)
            {
                <p style="color: #94a3b8;">You have not submitted any applications yet.</p>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8; font-size: 0.85rem; text-align: left;">
                            <th style="padding: 10px;">App ID</th>
                            <th style="padding: 10px;">Animal</th>
                            <th style="padding: 10px;">Branch</th>
                            <th style="padding: 10px;">Date</th>
                            <th style="padding: 10px;">Linked Visit</th>
                            <th style="padding: 10px;">Status</th>
                            <th style="padding: 10px;">Rejection Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in applications)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.9rem;">
                                <td style="padding: 10px;">#@app.Id</td>
                                <td style="padding: 10px;"><strong>@app.AnimalName</strong> (@app.AnimalSpecies)</td>
                                <td style="padding: 10px;">@app.BranchName</td>
                                <td style="padding: 10px;">@app.ApplicationDate.ToString("yyyy-MM-dd")</td>
                                <td style="padding: 10px;">
                                    @(app.LinkedVisit != null ? $"Visit #{app.LinkedVisit.Id} ({app.LinkedVisit.SlotDate:yyyy-MM-dd})" : "None")
                                </td>
                                <td style="padding: 10px;">
                                    <span style="padding: 2px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: @(app.Status == ApplicationStatus.Approved ? "rgba(16, 185, 129, 0.2)" : (app.Status == ApplicationStatus.Rejected ? "rgba(239, 68, 68, 0.2)" : "rgba(245, 158, 11, 0.2)")); color: @(app.Status == ApplicationStatus.Approved ? "#34d399" : (app.Status == ApplicationStatus.Rejected ? "#f87171" : "#fbbf24"));">
                                        @app.Status
                                    </span>
                                </td>
                                <td style="padding: 10px; color: #f87171;">
                                    @(app.Status == ApplicationStatus.Rejected ? app.RejectionReason : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else if (activeSubTab == "visits")
    {
        <div style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 20px;">
            <h2 style="margin-top: 0; font-size: 1.25rem;">My Booked Visits</h2>
            @if (visits.Count == 0)
            {
                <p style="color: #94a3b8;">You have no booked visits.</p>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8; font-size: 0.85rem; text-align: left;">
                            <th style="padding: 10px;">Visit ID</th>
                            <th style="padding: 10px;">Animal</th>
                            <th style="padding: 10px;">Date & Time</th>
                            <th style="padding: 10px;">Status</th>
                            <th style="padding: 10px;">Staff Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in visits)
                        {
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.9rem;">
                                <td style="padding: 10px;">#@v.Id</td>
                                <td style="padding: 10px;"><strong>@v.AnimalName</strong> (@v.AnimalSpecies)</td>
                                <td style="padding: 10px;">@v.SlotDate?.ToString("yyyy-MM-dd") @v.SlotTime</td>
                                <td style="padding: 10px;">
                                    <span style="padding: 2px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background: rgba(99, 102, 241, 0.2); color: #818cf8;">
                                        @v.Status
                                    </span>
                                </td>
                                <td style="padding: 10px; color: #94a3b8;">@(v.StaffNotes ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <!-- Apply Modal -->
    @if (selectedApplyPet != null)
    {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 50;">
            <div style="background: #1e293b; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 24px; width: 100%; max-width: 480px;">
                <h3 style="margin-top: 0;">Apply for @selectedApplyPet.Name</h3>
                
                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Link Completed Visit (Optional):</label>
                    <select class="form-select" @bind="selectedVisitBookingId" style="width: 100%; background: #0f172a; color: #fff; border: 1px solid #475569; padding: 8px; border-radius: 6px;">
                        <option value="0">No visit linked / Apply directly</option>
                        @foreach (var v in visits.Where(v => v.AnimalId == selectedApplyPet.Id))
                        {
                            <option value="@v.Id">Visit #@v.Id (@v.SlotDate?.ToString("yyyy-MM-dd")) - @v.Status</option>
                        }
                    </select>
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Application Notes:</label>
                    <textarea @bind="applicationNotes" rows="3" class="form-textarea" placeholder="Tell us about your home environment..." style="width: 100%; background: #0f172a; color: #fff; border: 1px solid #475569; padding: 8px; border-radius: 6px;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 12px;">
                    <button class="btn btn-secondary" @onclick="() => selectedApplyPet = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="SubmitApplication">Submit Application</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .btn { padding: 8px 16px; border-radius: 6px; border: none; font-weight: 500; cursor: pointer; transition: all 0.2s ease; }
    .btn-primary { background: #6366f1; color: #fff; }
    .btn-primary:hover { background: #4f46e5; }
    .btn-secondary { background: rgba(255, 255, 255, 0.1); color: #cbd5e1; }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
</style>

@code {
    private string activeSubTab = "animals";
    private string? feedbackMessage;

    private List<Animal> pets = new();
    private List<ApplicationResponseDto> applications = new();
    private List<VisitBookingResponseDto> visits = new();

    private Animal? selectedApplyPet;
    private int selectedVisitBookingId;
    private string applicationNotes = "";

    protected override async Task OnInitializedAsync()
    {
        ApiClient.OnUserChanged += async () => await LoadDataAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        // Load initial mock pet catalog
        pets = new List<Animal>
        {
            new() { Id = 2, Name = "Whiskers", Species = "Cat", Breed = "Persian", Age = 2, Gender = "Female", Status = AnimalStatus.Available, BranchId = 1, Description = "Calm, fluffy feline who enjoys quiet cuddles.", ImageUrl = "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600&auto=format&fit=crop&q=80" },
            new() { Id = 3, Name = "Rocky", Species = "Dog", Breed = "Beagle", Age = 1, Gender = "Male", Status = AnimalStatus.Available, BranchId = 1, Description = "Playful pup with a great curious nose.", ImageUrl = "https://images.unsplash.com/photo-1537151608828-ea2b11777ee8?w=600&auto=format&fit=crop&q=80" },
            new() { Id = 4, Name = "Tweety", Species = "Bird", Breed = "Canary", Age = 1, Gender = "Female", Status = AnimalStatus.Available, BranchId = 2, Description = "Cheerful yellow singing canary looking for a home.", ImageUrl = "https://images.unsplash.com/photo-1522858547137-f1dcec554f55?w=600&auto=format&fit=crop&q=80" },
            new() { Id = 6, Name = "Coco", Species = "Dog", Breed = "Poodle", Age = 2, Gender = "Female", Status = AnimalStatus.Available, BranchId = 2, Description = "Intelligent, hypoallergenic companion.", ImageUrl = "https://images.unsplash.com/photo-1591769225440-811ad7d6eab2?w=600&auto=format&fit=crop&q=80" }
        };

        var appRes = await ApiClient.GetApplicationsAsync();
        applications = appRes?.Data ?? new List<ApplicationResponseDto>();

        var visitRes = await ApiClient.GetVisitBookingsAsync();
        visits = visitRes?.Data ?? new List<VisitBookingResponseDto>();

        StateHasChanged();
    }

    private void OpenApplyModal(Animal pet)
    {
        selectedApplyPet = pet;
        selectedVisitBookingId = 0;
        applicationNotes = "";
    }

    private void OpenBookVisitModal(Animal pet)
    {
        feedbackMessage = $"PawTrack Visit Policy: Booking visit for {pet.Name}. Note that visits do NOT lock or reserve the animal!";
    }

    private async Task SubmitApplication()
    {
        if (selectedApplyPet == null) return;

        var res = await ApiClient.SubmitApplicationAsync(new SubmitApplicationDto
        {
            AnimalId = selectedApplyPet.Id,
            VisitBookingId = selectedVisitBookingId > 0 ? selectedVisitBookingId : null,
            Notes = applicationNotes
        });

        if (res != null && res.Success)
        {
            feedbackMessage = $"Adoption application submitted for {selectedApplyPet.Name}!";
            selectedApplyPet = null;
            await LoadDataAsync();
        }
        else
        {
            feedbackMessage = $"Error: {res?.Error ?? "Submission failed."}";
        }
    }

    public void Dispose()
    {
        ApiClient.OnUserChanged -= async () => await LoadDataAsync();
    }
}
